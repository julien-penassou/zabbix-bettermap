{
	"manifest_version": 2.0,
	"id": "bettermapswidget",
	"type": "widget",
	"name": "Carte+ (widget)",
	"namespace": "BetterMapsWidget",
	"version": "1.0",
	"author": "Julien Penassou",
	"description": "Affiche une carte Cartes+ dans un tableau de bord. Nécessite le module Better Maps.",
	"widget": {
		"name": "Carte+",
		"js_class": "CWidgetBetterMap",
		"refresh_rate": 30,
		"size": {
			"width": 36,
			"height": 8
		}
	},
	"actions": {
		"widget.bettermapswidget.view": {
			"class": "WidgetView"
		}
	},
	"assets": {
		"js": ["class.widget.js"]
	}
}
