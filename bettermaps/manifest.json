{
	"manifest_version": 2.0,
	"id": "bettermaps",
	"type": "widget",
	"name": "Better Maps",
	"version": "1.3",
	"namespace": "BetterMaps",
	"author": "Julien Penassou",
	"description": "Cartes réseau façon draw.io (Surveillance › Cartes+) et widget « Carte+ » pour les tableaux de bord.",
	"widget": {
		"name": "Carte+",
		"js_class": "CWidgetBetterMap",
		"refresh_rate": 30,
		"size": {
			"width": 36,
			"height": 8
		}
	},
	"actions": {
		"bettermap.list": {
			"class": "MapList",
			"view": "bettermap.list"
		},
		"bettermap.view": {
			"class": "MapView",
			"view": "bettermap.view"
		},
		"bettermap.create": {
			"class": "MapCreate",
			"layout": "layout.json"
		},
		"bettermap.save": {
			"class": "MapSave",
			"layout": "layout.json"
		},
		"bettermap.delete": {
			"class": "MapDelete",
			"layout": "layout.json"
		},
		"bettermap.search": {
			"class": "ObjectSearch",
			"layout": "layout.json"
		},
		"bettermap.status": {
			"class": "MapStatus",
			"layout": "layout.json"
		},
		"bettermap.icon": {
			"class": "IconView"
		},
		"bettermap.icon.list": {
			"class": "IconList",
			"layout": "layout.json"
		},
		"bettermap.icon.upload": {
			"class": "IconUpload",
			"layout": "layout.json"
		},
		"bettermap.icon.delete": {
			"class": "IconDelete",
			"layout": "layout.json"
		},
		"widget.bettermaps.view": {
			"class": "WidgetView"
		}
	},
	"assets": {
		"css": ["bettermap.css"],
		"js": ["bettermap.js", "class.widget.js"]
	}
}
